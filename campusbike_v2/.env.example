# Generate a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Google OAuth / OpenID Connect web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank during personal testing to allow any verified Google account.
# For a college deployment, set the college Google Workspace domain, e.g. college.edu.
# Multiple domains may be comma-separated.
ALLOWED_EMAIL_DOMAINS=

# Admin account. Change these immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Set to 1 only when the app is always served over HTTPS.
SESSION_COOKIE_SECURE=0

# Explicit opt-in for seeded STU001-STU005 test accounts only. Never enable for a pilot.
CAMPUSBIKE_DEV_LOGIN=0
